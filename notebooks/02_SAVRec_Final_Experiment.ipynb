# ==============================================================================
# 8. DETERMINISTIC CASE SELECTION
# ==============================================================================
#
# Fixed percentile rule:
#
#   Low gate    -> nearest to 10th percentile
#   Median gate -> nearest to 50th percentile
#   High gate   -> nearest to 90th percentile
#
# No manual selection is performed.
# ==============================================================================

selection_quantiles_40 = [
    (
        "Low gate",
        0.10
    ),
    (
        "Median gate",
        0.50
    ),
    (
        "High gate",
        0.90
    ),
]


gate_values_40 = (
    case_base_40[
        "gate_mean_3seed"
    ]
    .to_numpy(
        dtype=float
    )
)


selected_rows_40 = []
used_indices_40 = set()


for case_name_40, quantile_40 in selection_quantiles_40:

    target_gate_40 = float(
        np.quantile(
            gate_values_40,
            quantile_40
        )
    )

    candidates_40 = (
        case_base_40.loc[
            ~case_base_40.index.isin(
                used_indices_40
            )
        ]
        .copy()
    )

    candidates_40[
        "_gate_distance"
    ] = (
        candidates_40[
            "gate_mean_3seed"
        ]
        -
        target_gate_40
    ).abs()


    # Deterministic tie-breaking.
    candidates_40 = (
        candidates_40
        .sort_values(
            [
                "_gate_distance",
                "img_hotel_id",
                "user_id",
            ],
            ascending=True,
            kind="stable"
        )
    )


    chosen_40 = (
        candidates_40
        .iloc[0]
        .copy()
    )


    used_indices_40.add(
        chosen_40.name
    )


    chosen_40[
        "case"
    ] = case_name_40

    chosen_40[
        "target_quantile"
    ] = float(
        quantile_40
    )

    chosen_40[
        "target_gate_quantile_value"
    ] = target_gate_40


    selected_rows_40.append(
        chosen_40
    )


