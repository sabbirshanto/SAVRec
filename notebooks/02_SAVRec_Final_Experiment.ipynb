    ].copy()
    assert set(clean['seed'].astype(int)) == set(SEEDS)
    for _, r0 in clean.iterrows():
        row = _expected_test_stress_signature(
            label, int(r0['seed']), -1, 0.0
        )
        row['mean_images_remaining'] = float(
            CANONICAL_IMG_MSK.sum(1).float().mean().item()
