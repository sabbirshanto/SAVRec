class LightGCNOnly(
    nn.Module
):

    def __init__(self):

        super().__init__()

        self.ue = nn.Embedding(
            num_users,
            EMBED_DIM
        )

        self.ie = nn.Embedding(
            num_items,
            EMBED_DIM
        )


        nn.init.normal_(
            self.ue.weight,
            std=0.01
        )

        nn.init.normal_(
            self.ie.weight,
            std=0.01
        )


    def gcn(self):

        e = torch.cat(
            [
                self.ue.weight,
                self.ie.weight
            ],
            dim=0
        )

        outputs = [
            e
        ]


        for _ in range(
            K_LAYERS
        ):

            e = torch.sparse.mm(
                sparse_adj,
                e
            )

            outputs.append(
                e
            )


        e = torch.stack(
            outputs,
            dim=1
        ).mean(
            dim=1
        )


        return torch.split(
            e,
            [
                num_users,
                num_items
            ],
            dim=0
        )


    def score_batch(
        self,
        users,
        items=None,
        catalog_matrix=None
    ):

        u_g, i_g = self.gcn()

        return (
            u_g[
                users
            ]
            @
            i_g.T
        )



