].isna().any():

    bad_items_40 = (
        gate_stats_40.loc[
            gate_stats_40[
                "item_index"
            ].isna(),
            "img_hotel_id"
        ]
        .unique()
        .tolist()
    )

    raise RuntimeError(
        "Validation hotels missing from item map: "
        +
        str(
            bad_items_40[:10]
        )
    )


gate_stats_40[
    "item_index"
] = (
    gate_stats_40[
        "item_index"
    ]
    .astype(int)
)


# ==============================================================================
# 7. BUILD COMPLETE CASE TABLE
# ==============================================================================

case_base_40 = (
    gate_stats_40
    .merge(
        user_history_40,
        on="user_id",
        how="left",
        validate="many_to_one"
    )
    .merge(
        item_evidence_40[
            [
                "item_index",
                "train_popularity",
                "train_popularity_norm",
                "visual_image_count",
                "visual_availability",
                "visual_coherence",
            ]
        ],
        on="item_index",
        how="left",
        validate="many_to_one"
    )
)


assert len(
    case_base_40
) == 9_045


required_analysis_cols_40 = [
    "train_user_history",
    "train_popularity",
    "train_popularity_norm",
    "visual_image_count",
    "visual_availability",
    "visual_coherence",
    "gate_mean_3seed",
]

assert (
    case_base_40[
        required_analysis_cols_40
    ]
    .notna()
    .all()
    .all()
)


print(
    f"Joined validation cases  : "
    f"{len(case_base_40):,}"
)


# ==============================================================================
# 8. DETERMINISTIC CASE SELECTION
# ==============================================================================
#
# Fixed percentile rule:
#
#   Low gate    -> nearest to 10th percentile
#   Median gate -> nearest to 50th percentile
#   High gate   -> nearest to 90th percentile
#
# No manual selection is performed.
# ==============================================================================

selection_quantiles_40 = [
    (
        "Low gate",
        0.10
    ),
    (
        "Median gate",
        0.50
    ),
    (
        "High gate",
        0.90
    ),
]


gate_values_40 = (
    case_base_40[
        "gate_mean_3seed"
    ]
    .to_numpy(
        dtype=float
    )
)


selected_rows_40 = []
used_indices_40 = set()


for case_name_40, quantile_40 in selection_quantiles_40:

    target_gate_40 = float(
        np.quantile(
            gate_values_40,
            quantile_40
        )
    )

    candidates_40 = (
        case_base_40.loc[
            ~case_base_40.index.isin(
                used_indices_40
            )
        ]
        .copy()
    )

    candidates_40[
        "_gate_distance"
    ] = (
        candidates_40[
            "gate_mean_3seed"
        ]
        -
        target_gate_40
    ).abs()


    # Deterministic tie-breaking.
    candidates_40 = (
        candidates_40
        .sort_values(
            [
                "_gate_distance",
                "img_hotel_id",
                "user_id",
            ],
            ascending=True,
            kind="stable"
        )
    )


    chosen_40 = (
        candidates_40
        .iloc[0]
        .copy()
    )


    used_indices_40.add(
        chosen_40.name
    )


    chosen_40[
        "case"
    ] = case_name_40

    chosen_40[
        "target_quantile"
    ] = float(
        quantile_40
    )

    chosen_40[
        "target_gate_quantile_value"
    ] = target_gate_40


    selected_rows_40.append(
        chosen_40
    )


case_study_40 = (
    pd.DataFrame(
        selected_rows_40
    )
    .reset_index(
        drop=True
    )
)


assert len(
    case_study_40
) == 3

assert (
    case_study_40[
        "user_id"
    ]
    .nunique()
    == 3
)

assert (
    case_study_40[
        "gate_mean_3seed"
    ]
    .between(
        0.0,
        1.0
    )
    .all()
)


