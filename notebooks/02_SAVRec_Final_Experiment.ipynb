def make_quartile_group(series):
    s = pd.Series(series, index=series.index, dtype=float)
    pct = s.rank(method='average', pct=True)
    return pd.cut(
        pct,
        bins=[0.0, 0.25, 0.50, 0.75, 1.0000001],
        labels=['Q1-low', 'Q2', 'Q3', 'Q4-high'],
        include_lowest=True,
        ordered=True
    )

